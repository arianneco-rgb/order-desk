# ── Order Desk environment ──────────────────────────────────────────────
# Every integration checks its own variable independently.
# Missing var = that layer runs in mock/snapshot mode. Mix and match freely.

# ── Auth (recommended even locally) ─────────────────────────────────────
# Shared dashboard password + secret used to sign the session cookie.
# If DASHBOARD_PASSWORD is unset, auth is DISABLED (open dashboard, local dev only).
DASHBOARD_PASSWORD=
AUTH_SECRET=

# ── Shopify (LIVE mode) ──────────────────────────────────────────────────
# SHOPIFY_STORE is the *.myshopify.com subdomain (e.g. "ritual-matcha-dev").
# ⚠️ Point this at a TEST/DEV store until the team signs off on production.
#
# Two ways to authenticate — set ONE pair, see SETUP.md step 1 for the full
# walkthrough of either path:
#
#   Dev Dashboard app (dev.shopify.com — current Shopify flow, no static
#   token to copy; the app exchanges these for a short-lived token itself
#   and auto-refreshes it, see lib/shopify.ts):
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
#   — or — admin-created custom app (Shopify admin → Settings → Apps and
#   sales channels → Develop apps — the older flow, gives a static token you
#   reveal once). Leave the two above blank if you use this instead:
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2025-07

# ── Google Sheets (one spreadsheet, two tabs: Customers, Order History) ─
# Create a Google Cloud service account with the Sheets API enabled,
# share the spreadsheet with the service-account email as Editor,
# then paste the full service-account JSON (single line) and the sheet id.
# The Order Desk spreadsheet already exists ("RMC Order Desk - Customers and
# Order History"), owned by arianne.co@ritualmatcha.ph:
#   1-51E1TzDLNQzjnpPxqE6BmJ5Pj6cALFcNg5-bguF45E
# On first live run the app renames the imported tab to "Customers" and adds
# "Order History" automatically (lib/sheets.ts -> ensureTabs). See SETUP.md
# for how to create + share the service account that reads/writes it.
GOOGLE_SA_JSON=
SHEET_ID=1-51E1TzDLNQzjnpPxqE6BmJ5Pj6cALFcNg5-bguF45E

# ── Anthropic Claude (later — replaces the fallback parser) ─────────────
ANTHROPIC_API_KEY=

# ── BPI mailbox (later — replaces the simulated inbox) ──────────────────
# A Google service account reads the mailbox read-only via the Gmail API —
# no IMAP, no mailbox password. Reuses GOOGLE_SA_JSON above unless
# BPI_GMAIL_SA_JSON is set separately. Requires a Google Workspace admin to
# authorize that service account for domain-wide delegation with the
# https://www.googleapis.com/auth/gmail.readonly scope. See SETUP.md step 4.
BPI_GMAIL_SA_JSON=
BPI_GMAIL_USER=
BPI_EMAIL_QUERY=

# ── Supabase (later — replaces the in-memory store) ─────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
