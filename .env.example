# ── Order Desk environment ──────────────────────────────────────────────
# Every integration checks its own variable independently.
# Missing var = that layer runs in mock/snapshot mode. Mix and match freely.

# ── Auth (recommended even locally) ─────────────────────────────────────
# Shared dashboard password + secret used to sign the session cookie.
# If DASHBOARD_PASSWORD is unset, auth is DISABLED (open dashboard, local dev only).
DASHBOARD_PASSWORD=
AUTH_SECRET=

# ── Shopify (LIVE mode) ──────────────────────────────────────────────────
# SHOPIFY_STORE is the *.myshopify.com subdomain (e.g. "ritual-matcha-dev").
# ⚠️ Point this at a TEST/DEV store until the team signs off on production.
#
# Two ways to authenticate — set ONE pair, see SETUP.md step 1 for the full
# walkthrough of either path:
#
#   Dev Dashboard app (dev.shopify.com — current Shopify flow, no static
#   token to copy; the app exchanges these for a short-lived token itself
#   and auto-refreshes it, see lib/shopify.ts):
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
#   — or — admin-created custom app (Shopify admin → Settings → Apps and
#   sales channels → Develop apps — the older flow, gives a static token you
#   reveal once). Leave the two above blank if you use this instead:
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2025-07

# ── Google Sheets + BPI (one Apps Script Web App bridges both) ──────────
# One spreadsheet, two tabs: Customers, Order History. The Order Desk
# spreadsheet already exists ("RMC Order Desk - Customers and Order
# History"), owned by arianne.co@ritualmatcha.ph:
#   1-51E1TzDLNQzjnpPxqE6BmJ5Pj6cALFcNg5-bguF45E
#
# A Cloud service account was the original plan, but a Workspace admin can
# block domain-wide delegation (as ours did) — so instead, deploy
# scripts/apps-script/Code.gs as a Web App under a regular Google account:
#   1. script.google.com → New project → paste in Code.gs.
#   2. Fill in SHEET_ID and SECRET_KEY constants at the top of Code.gs.
#   3. Deploy → New deployment → type "Web app" → Execute as: Me,
#      Who has access: Anyone → Deploy → copy the URL (ends in /exec).
#   4. Paste that URL + your SECRET_KEY below.
# See SETUP.md for the full walkthrough.
#
# BPI matching reuses this same bridge (GmailApp.search under the deploying
# account) — deploy it from whichever Google account actually receives BPI
# transfer-notification emails.
SHEET_ID=1-51E1TzDLNQzjnpPxqE6BmJ5Pj6cALFcNg5-bguF45E
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
BPI_EMAIL_QUERY=

# ── Anthropic Claude (later) ─────────────────────────────────────────────
# One key turns on TWO features: Claude parsing of pasted messages (replaces
# the keyword/regex fallback) AND proof-screenshot reading (amount/ref read
# off uploaded payment screenshots, auto-compared to the order total).
ANTHROPIC_API_KEY=

# Drafts unpaid for this many days show in the "Needs follow-up" queue (default 3).
FOLLOW_UP_DAYS=

# ── Supabase (persistent store — orders survive restarts/redeploys) ─────
# The app reads SUPABASE_URL + SUPABASE_SECRET_KEY (server-side only).
# Create the tables once: Supabase dashboard → SQL Editor → run
# scripts/db/schema.sql. Leave blank for an in-memory store (local demos).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
